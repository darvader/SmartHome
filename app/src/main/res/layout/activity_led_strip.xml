<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/led_actitivy_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LED Strip Control"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Color Controls -->
    <SeekBar
        android:id="@+id/redSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="255"
        android:progress="1"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/greenSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="255"
        android:progress="1"
        app:layout_constraintTop_toBottomOf="@id/redSeekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/blueSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="255"
        android:progress="1"
        app:layout_constraintTop_toBottomOf="@id/greenSeekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/whiteSeekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="255"
        android:progress="1"
        app:layout_constraintTop_toBottomOf="@id/blueSeekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Effect Controls -->
    <SeekBar
        android:id="@+id/divisor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="10"
        android:progress="1"
        app:layout_constraintTop_toBottomOf="@id/whiteSeekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/delay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progress="50"
        app:layout_constraintTop_toBottomOf="@id/divisor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/speed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="50"
        app:layout_constraintTop_toBottomOf="@id/delay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Effect Buttons Row 1 -->
    <Button
        android:id="@+id/detect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:text="Detect"
        app:layout_constraintTop_toBottomOf="@id/speed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/seven"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/seven"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:text="Seven"
        app:layout_constraintTop_toTopOf="@id/detect"
        app:layout_constraintStart_toEndOf="@id/detect"
        app:layout_constraintEnd_toStartOf="@id/white" />

    <Button
        android:id="@+id/white"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="White"
        app:layout_constraintTop_toTopOf="@id/detect"
        app:layout_constraintStart_toEndOf="@id/seven"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Effect Buttons Row 2 -->
    <Button
        android:id="@+id/dot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="Dot"
        app:layout_constraintTop_toBottomOf="@id/detect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rain" />

    <Button
        android:id="@+id/rain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:text="Rain"
        app:layout_constraintTop_toTopOf="@id/dot"
        app:layout_constraintStart_toEndOf="@id/dot"
        app:layout_constraintEnd_toStartOf="@id/rainbow" />

    <Button
        android:id="@+id/rainbow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Rainbow"
        app:layout_constraintTop_toTopOf="@id/dot"
        app:layout_constraintStart_toEndOf="@id/rain"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FFT Buttons Row 3 -->
    <Button
        android:id="@+id/fft"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="FFT"
        app:layout_constraintTop_toBottomOf="@id/dot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/fftRow" />

    <Button
        android:id="@+id/fftRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:text="FFT Row"
        app:layout_constraintTop_toTopOf="@id/fft"
        app:layout_constraintStart_toEndOf="@id/fft"
        app:layout_constraintEnd_toStartOf="@id/off" />

    <Button
        android:id="@+id/off"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Off"
        app:layout_constraintTop_toTopOf="@id/fft"
        app:layout_constraintStart_toEndOf="@id/fftRow"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Remote FFT Buttons Row 4 -->
    <Button
        android:id="@+id/fftRemote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="FFT Remote"
        app:layout_constraintTop_toBottomOf="@id/fft"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/fftRowRemote" />

    <Button
        android:id="@+id/fftRowRemote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="FFT Row Remote"
        app:layout_constraintTop_toTopOf="@id/fftRemote"
        app:layout_constraintStart_toEndOf="@id/fftRemote"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
